guarded\", [\"url\"]]]}], [\"create_pr\", {\"__dict__\": [[\"output\", \"trusted\"], [\"guarded\", [\"repo\", \"body\"]]]}]]}, [{\"__dict__\": [[\"id\", \"s1\"], [\"tool\", \"read_inbox\"], [\"args\", {\"__dict__\": [[\"folder\", \"inbox\"], [\"limit\", 20]]}]]}, {\"__dict__\": [[\"id\", \"s2\"], [\"tool\", \"get_contact\"], [\"args\", {\"__dict__\": [[\"name\", \"Bob\"]]}]]}, {\"__dict__\": [[\"id\", \"s3\"], [\"tool\", \"summarize\"], [\"args\", {\"__dict__\": [[\"text\", {\"__dict__\": [[\"from\", [\"s1\"]]]}]]}]]}, {\"__dict__\": [[\"id\", \"s4\"], [\"tool\", \"send_email\"], [\"args\", {\"__dict__\": [[\"to\", {\"__dict__\": [[\"from\", [\"s2\"]]]}], [\"body\", {\"__dict__\": [[\"from\", [\"s3\"]]]}]]}]]}, {\"__dict__\": [[\"id\", \"s5\"], [\"tool\", \"send_email\"], [\"args\", {\"__dict__\": [[\"to\", {\"__dict__\": [[\"from\", [\"s1\"]]]}], [\"body\", {\"__dict__\": [[\"from\", [\"s2\"]]]}]]}]]}, {\"__dict__\": [[\"id\", \"s6\"], [\"tool\", \"fetch_url\"], [\"args\", {\"__dict__\": [[\"url\", {\"__dict__\": [[\"from\", [\"s5\"]]]}]]}]]}], \"context\", []], \"e\": {\"__dict__\": [[\"decisions\", [{\"__tup__\": [\"s1\", \"allow\"]}, {\"__tup__\": [\"s2\", \"allow\"]}, {\"__tup__\": [\"s3\", \"allow\"]}, {\"__tup__\": [\"s4\", \"block\"]}, {\"__tup__\": [\"s5\", \"block\"]}, {\"__tup__\": [\"s6\", \"skip\"]}]], [\"tainted\", [\"s1\", \"s2\", \"s3\"]]]}}, {\"a\": [{\"__dict__\": [[\"read_inbox\", {\"__dict__\": [[\"output\", \"untrusted\"], [\"guarded\", []]]}], [\"get_contact\", {\"__dict__\": [[\"output\", \"trusted\"], [\"guarded\", []]]}], [\"read_calendar\", {\"__dict__\": [[\"output\", \"trusted\"], [\"guarded\", []]]}], [\"summarize\", {\"__dict__\": [[\"output\", \"trusted\"], [\"guarded\", []]]}], [\"send_email\", {\"__dict__\": [[\"output\", \"trusted\"], [\"guarded\", [\"to\"]]]}], [\"fetch_url\", {\"__dict__\": [[\"output\", \"untrusted\"], [\"guarded\", [\"url\"]]]}], [\"create_pr\", {\"__dict__\": [[\"output\", \"trusted\"], [\"guarded\", [\"repo\",