---
// One layout for every page: stylesheets, fonts, KaTeX, the Unroll header (nav, route chip, streak, level/XP, search).
import { u } from '../lib/url.mjs';
import 'katex/dist/katex.min.css';
import '../styles/site.css';
import '../styles/unroll.css';
import destinations from '../content/destinations.json';
import '../styles/legacy.css';
interface Props {
  title: string; description?: string; course?: any; courseId?: string; crumbs?: [string, string][]; side?: boolean;
  css?: string;            // stylesheet in public/css/ (defaults to the course's, else "house")
  pagefind?: boolean;      // index this page for search (lesson and problem pages)
  unroll?: boolean;        // a redesigned Unroll screen: always dark, no house stylesheet, full-width main (layouts/Unroll.astro)
}
const { unroll = false, title, description = 'Every concept, one step at a time. Courses and practice for machine learning, AI and the systems behind them.', course, side = false, pagefind = false } = Astro.props;
const css = Astro.props.css ?? course?.css ?? 'house';
const path = Astro.url.pathname;
const BASE = import.meta.env.BASE_URL.replace(/\/$/, '');
const nav = [['Learn', '/'], ['Arena', '/arena/'], ['Review', '/review/']];
const on = (p: string) => p === '/' ? path === u('/') || path.startsWith(u('/learn/')) : path.startsWith(u(p));
const ROUTES = Object.fromEntries(destinations.destinations.map(d => [d.id, d.name]));   // route chip: chosen destination's name
const full = title === 'Unroll' ? title : `${title} · Unroll`;
---
<!doctype html>
<html lang="en" data-theme="dark">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  {/* Phones (≤640px) use the light mobile surface (tokens.css [data-surface="mobile"]); older pages' house stylesheet
      switches to its light values too. Set before any CSS paints, and kept in sync if the width changes. */}
  <script is:inline>{(() => { const h = document.documentElement, q = matchMedia('(max-width: 640px)');
    const set = () => { h.toggleAttribute('data-surface', q.matches); if (q.matches) h.dataset.surface = 'mobile'; h.dataset.theme = q.matches ? 'light' : 'dark'; };
    set(); q.addEventListener('change', set); })()}</script>
  <meta name="description" content={description}>
  <title>{full}</title>
  <link rel="icon" href={u('/favicon.svg')} type="image/svg+xml">
  {/* Every page is Unroll (always dark). Older pages keep their course/house stylesheet for layout and figures, loaded
      into a lower cascade layer, so the Unroll tokens (layer "unroll", styles/unroll.css) win for colours and fonts. */}
  {!unroll && <style is:inline set:html={`@layer house, unroll;\n@import url("${u(`/css/${css}.css`)}") layer(house);`} />}
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Geist:wght@400;450;500;600;650;700;800&family=Geist+Mono:wght@400;500;600&display=swap" rel="stylesheet">
  <slot name="head" />
</head>
<body data-base={BASE}>
  <div id="readbar"></div>
  <header class="u-top m-fade" data-theme="dark" data-pagefind-ignore>
    {side && <button type="button" class="ibtn" id="menu" aria-label="Open menu"><svg width="18" height="18" viewBox="0 0 18 18" aria-hidden="true"><path d="M3 5h12M3 9h12M3 13h12" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg></button>}
    <a class="u-brand" href={u('/')} aria-label="Unroll home"><svg viewBox="0 0 288.17 64" aria-hidden="true"><rect x="4" y="42" width="18" height="18" rx="5" fill="var(--brand-ink)"/><rect x="23" y="23" width="18" height="18" rx="5" fill="var(--brand-ink)"/><rect x="42" y="4" width="18" height="18" rx="5" fill="var(--brand-accent)"/><path transform="translate(80 0)" fill="var(--brand-ink)" d="M5.21 44.94V17.72H17.04V42.17Q17.04 47.06 18.54 49.31Q20.03 51.56 23.27 51.56Q26.97 51.56 28.95 49.08Q30.92 46.59 30.92 41.62V17.72H42.75V60H31.94L31.79 53.22Q28.47 60.95 19.09 60.95Q12.54 60.95 8.87 56.77Q5.21 52.59 5.21 44.94Z M48.74 17.72H59.39L59.63 24.66Q62.94 16.78 72.17 16.78Q78.95 16.78 82.74 21.08Q86.52 25.37 86.52 32.79V60H74.69V36.73Q74.69 31.37 73.23 28.77Q71.77 26.16 68.23 26.16Q64.52 26.16 62.55 28.92Q60.57 31.68 60.57 36.73V60H48.74Z M92.6 17.72H103.8L104.03 26.24Q105.3 21.75 107.74 19.74Q110.19 17.72 114.13 17.72H117.99V27.5H114.13Q109.08 27.5 106.75 29.55Q104.43 31.61 104.43 36.26V60H92.6Z M119.73 38.86Q119.73 32.24 122.41 27.23Q125.09 22.22 129.94 19.5Q134.79 16.78 141.18 16.78Q147.57 16.78 152.42 19.5Q157.27 22.22 159.95 27.23Q162.64 32.24 162.64 38.86Q162.64 45.49 159.99 50.5Q157.35 55.5 152.46 58.23Q147.57 60.95 141.18 60.95Q134.79 60.95 129.9 58.23Q125.01 55.5 122.37 50.5Q119.73 45.49 119.73 38.86ZM150.41 38.86Q150.41 32.71 148.01 29.28Q145.6 25.85 141.18 25.85Q136.77 25.85 134.32 29.28Q131.88 32.71 131.88 38.86Q131.88 45.01 134.32 48.45Q136.77 51.88 141.18 51.88Q145.6 51.88 148.01 48.45Q150.41 45.01 150.41 38.86Z M166.58 48.96V4H178.41V47.7Q178.41 49.51 179.24 50.34Q180.07 51.17 181.8 51.17H184.64V60H177.62Q166.58 60 166.58 48.96Z M188.11 48.96V4H199.94V47.7Q199.94 49.51 200.77 50.34Q201.6 51.17 203.34 51.17H206.17V60H199.15Q188.11 60 188.11 48.96Z"/></svg></a>
    <nav class="u-nav" aria-label="Main">{nav.map(([t, p]) => <a href={u(p)} aria-current={on(p) ? 'page' : undefined} id={t === 'Review' ? 'navR' : undefined}>{t}</a>)}</nav>
    <span style="flex:1"></span>
    <a class="u-route" href={u('/destinations/')} aria-current={on('/destinations/') ? 'page' : undefined}><span class="mono">ROUTE</span> <span id="routeName">Choose a goal</span></a>
    <span class="u-streak off" id="chipS" title="Day streak"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3c1 4 5 5.5 5 10a5 5 0 0 1-10 0c0-2 1-3.5 2.5-4.5C9.5 11 11 12 12 12c-1-3 0-6 0-9z"/></svg><span id="chipSn">0</span></span>
    <span class="u-xp mono" id="chipX" title="Level and XP"></span>
    <a class="u-ibtn" href={u('/search/')} aria-label="Search"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="M20 20l-4-4"/></svg></a>
  </header>
  {/* phones: top bar (mockups/mobile/MobileHome) and three tabs (Learn · Arena · Review; no profile tab until it's designed) */}
  <div class="u-mtop" data-pagefind-ignore>
    <a class="u-mroute" href={u('/destinations/')}><span class="mono">ROUTE</span><span id="mRouteName">Choose a goal</span></a>
    <span style="flex:1"></span>
    <span class="u-mstreak" id="mStreak"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3c1 4 5 5.5 5 10a5 5 0 0 1-10 0c0-2 1-3.5 2.5-4.5C9.5 11 11 12 12 12c-1-3 0-6 0-9z"/></svg><span>0</span></span>
    <span class="u-mxp mono" id="mXp"></span>
    <a class="u-mic" href={u('/library/')} aria-label="Library"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 5h6a2 2 0 0 1 2 2v12a2 2 0 0 0-2-2H4z"/><path d="M20 5h-6a2 2 0 0 0-2 2v12a2 2 0 0 1 2-2h6z"/></svg></a>
    <a class="u-mic" href={u('/search/')} aria-label="Search"><svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="M20 20l-4-4"/></svg></a>
  </div>
  <nav class="u-tabs m-sheet" aria-label="Tabs" data-pagefind-ignore>
    <a href={u('/')} aria-current={on('/') ? 'page' : undefined}><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 11l8-7 8 7v9H4z"/></svg>Learn</a>
    <a href={u('/arena/')} aria-current={on('/arena/') || on('/practice/') ? 'page' : undefined}><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M8 7l-5 5 5 5"/><path d="M16 7l5 5-5 5"/></svg>Arena</a>
    <a href={u('/review/')} aria-current={on('/review/') ? 'page' : undefined} id="tabR"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="4" y="6" width="13" height="14" rx="2"/><path d="M8 3h11a1 1 0 0 1 1 1v13"/></svg><span>Review</span></a>
  </nav>
  {side
    ? <div class="shell"><aside class="side" id="side" aria-label="Navigation" data-pagefind-ignore><slot name="side" /></aside><main id="view"><slot /></main></div>
    : <main id="view" style={unroll ? undefined : 'max-width:1100px;margin:0 auto'}><slot /></main>}
  <div id="scrim"></div>
  <div id="toasts" aria-live="polite"></div>
  <script is:inline define:vars={{ ROUTES }}>window.__base = document.body.dataset.base;
    try { const r = JSON.parse(localStorage.getItem('tracks') || '{}').ns?.game?.route; if (ROUTES[r]) document.getElementById('routeName').textContent = document.getElementById('mRouteName').textContent = ROUTES[r]; } catch {}</script>
  <script>
    import { stats } from '../lib/progress.js';
    import { all } from '../lib/store.js';
    import { due } from '../lib/review.js';
    const cs = document.getElementById('chipS'), csn = document.getElementById('chipSn'), cx = document.getElementById('chipX'), nr = document.getElementById('navR');
    const chips = () => { const s = stats();
      cs.classList.toggle('off', !s.streak); cs.querySelector('svg').classList.toggle('m-flame', !!s.streak);
      cs.title = `${s.streak} day streak`; csn.textContent = s.streak;
      cx.textContent = `LV ${s.level} · ${s.xp.toLocaleString('en')} XP`;
      const ms = document.getElementById('mStreak'); ms.classList.toggle('off', !s.streak); ms.lastChild.textContent = s.streak;
      ms.querySelector('svg').classList.toggle('m-flame', !!s.streak); document.getElementById('mXp').textContent = `${s.xp.toLocaleString('en')} XP`; };
    chips(); addEventListener('tracks:save', chips);
    fetch(`${window.__base}/cards.json`).then(r => r.json()).then(cards => { const n = due(cards).length;
      if (n) { nr.insertAdjacentHTML('beforeend', `<span class="u-due mono" aria-label="${n} due">${n}</span>`);
        document.querySelector('#tabR span').textContent = `Review · ${n}`; } }).catch(() => {});
    // finished items: sidebar dots and list rows carry data-ns + data-lk
    const A = all();
    document.querySelectorAll('[data-lk]').forEach(el => { const ns = el.closest('[data-ns]')?.dataset.ns; if (ns && A[ns]?.done?.[el.dataset.lk]) el.classList.add('on'); });
    const side = document.getElementById('side'), scrim = document.getElementById('scrim');
    document.getElementById('menu')?.addEventListener('click', () => { side.classList.add('open'); scrim.classList.add('on'); });
    scrim?.addEventListener('click', () => { side.classList.remove('open'); scrim.classList.remove('on'); });
  </script>
</body>
</html>
