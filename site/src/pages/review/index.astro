---
// One review deck for the whole site (mockups/desktop/Review.dc.html): lesson self-check questions and solved problems,
// on the same 1-3-7-14-30 day schedule (review.js). Clearing the deck records game.clear[day] (+20 XP, game.js).
import Unroll from '../../layouts/Unroll.astro';
import '../../styles/screens/review.css';
---
<Unroll title="Review" description="Spaced review of lessons and problems across every course.">
  <div class="u-page" id="rv">
    <aside class="u-rail-l" aria-label="Deck" id="rvDeck"></aside>
    <main class="u-main rv-main" id="rvMain">
      <div class="rv-top m-fade"><div class="u-bar" role="progressbar" aria-label="Review progress" aria-valuemin="0" aria-valuemax="1" aria-valuenow="0" id="rvBar"><i></i></div><span class="mono" id="rvCnt">Loading…</span></div>
      <div id="rvStage" aria-live="polite"></div>
    </main>
    <aside class="u-rail-r" aria-label="Forecast" id="rvSide"></aside>
  </div>
  <script>
    import { routes, dueCards, href, esc, courseVar } from '../../lib/unroll.js';
    import { BOX, rate } from '../../lib/review.js';
    import { events, quests, REFRESHER, XP, addDays } from '../../lib/game.js';
    import { today, now } from '../../lib/progress.js';
    import { all, ns, save } from '../../lib/store.js';

    const $ = id => document.getElementById(id), B = window.__base, get = p => fetch(`${B}/${p}`).then(r => r.json());
    const plain = s => String(s ?? '').replace(/<[^>]*>/g, '');
    Promise.all([get('review.json'), routes(), dueCards(), get('practice/index.json')]).then(([Rv, R, items, I]) => {
      const P = Object.fromEntries(I.topics.flatMap(m => m.lessons).map(l => [l.id, l]));
      const folder = Object.fromEntries(Object.entries(R.courses).map(([f, c]) => [c.key, f]));   // namespace key → course folder
      const title = n => n === 'practice' ? 'Arena' : R.courses[folder[n]]?.title ?? n;
      const deck = items.filter(([n, k]) => Rv[n]?.[k]), probs = items.filter(([n, k]) => n === 'practice' && P[k]);
      for (let i = deck.length - 1; i > 0; i--) { const j = Math.floor(Math.random() * (i + 1)); [deck[i], deck[j]] = [deck[j], deck[i]]; }
      const total = deck.length, hadDue = items.length;
      let i = 0, revealed = false;

      const cardOf = () => Rv[deck[i][0]][deck[i][1]];
      // Next interval for each grade, from review.js: again → tomorrow, hard keeps the box, good steps up one box, easy two.
      const days = n => n === 1 ? '1 day' : `${n} days`;
      function intervals() {
        const [n, k] = deck[i], b = all()[n]?.rev?.[k]?.box || 0;
        return [null, days(Math.max(1, BOX[Math.max(1, b)])), days(BOX[Math.min(b + 1, BOX.length - 1)]), days(BOX[Math.min(b + 2, BOX.length - 1)])];
      }

      function renderDeck() {
        const left = {}; [...deck.slice(i), ...probs].forEach(([n]) => left[n] = (left[n] || 0) + 1);
        const n = Object.values(left).reduce((a, b) => a + b, 0);
        $('rvDeck').innerHTML = `<div class="lab">DUE TODAY · ${n}</div>` + Object.entries(left).map(([ns_, c], j) =>
          `<div class="rv-src m-rise" style="--i:${j + 1}"><span><i style="background:${ns_ === 'practice' ? 'var(--arena)' : courseVar(folder[ns_])}"></i>${esc(title(ns_))}</span><span class="mono">${c}</span></div>`).join('')
          + `<div class="rv-note">Cards come from lesson steps and from Arena problems you got wrong.</div>`
          + (probs.length ? `<div class="lab" style="margin-top:10px">PROBLEMS TO RE-SOLVE</div><div class="rv-probs">${probs.map(([, k]) =>
            `<a href="${B}/arena/p/${k}/"><b>${esc(P[k].t)}</b><span class="mono">${esc(P[k].d)}</span></a>`).join('')}</div>` : '');
      }

      function progress() {
        const pct = total ? Math.round(i / total * 100) : 0;
        $('rvBar').setAttribute('aria-valuemax', total || 1); $('rvBar').setAttribute('aria-valuenow', i);
        $('rvBar').firstChild.style.width = pct + '%';
        $('rvCnt').textContent = total ? `${Math.min(i + 1, total)} / ${total}` : '0 / 0';
      }

      function card() {
        revealed = false; progress(); renderDeck();
        if (i >= total) return total ? clear() : empty();
        const c = cardOf();
        $('rvStage').innerHTML = `<div class="rv-main" style="gap:18px"><section class="rv-card m-slide" aria-label="Card" id="rvCard">
          <div class="hd"><span class="lab">${esc(`${c.c} · ${c.t}`.toUpperCase())}</span><a href="${esc(c.u)}">Open lesson</a></div>
          <h1>${c.q}</h1><div id="rvAns"></div><div class="sp"></div><span class="mono hint" id="rvHint">Say it out loud first, then reveal.</span></section>
          <div id="rvAct"><button type="button" class="rv-show" id="rvShow">Show answer <span class="mono">space</span></button></div></div>`;
        $('rvShow').onclick = reveal;
      }

      function reveal() {
        if (revealed || i >= total) return; revealed = true;
        const t = intervals();
        $('rvAns').innerHTML = `<div class="rv-ans m-turn">${cardOf().s}</div>`; $('rvHint').remove();
        const g = [['again', 'Again', 'tomorrow', 1], ['hard', 'Hard', t[1], 2], ['good', 'Good', t[2], 3], ['easy', 'Easy', t[3], 4]];
        $('rvAct').innerHTML = `<div class="rv-grades" role="group" aria-label="How well did you remember?">${g.map(([c, l, s, v], j) =>
          `<button type="button" class="${c}" data-v="${v}" style="animation-delay:${j * 50}ms">${l}<small>${s}</small></button>`).join('')}</div>`;
        $('rvAct').querySelectorAll('button').forEach(b => b.onclick = () => grade(+b.dataset.v));
      }

      function grade(v) {
        rate(deck[i][0], deck[i][1], v); i++;
        // last card graded: the daily "clear the deck" quest (+20 XP, game.js), once a day
        if (i === total) { const g = ns('game'); g.clear ||= {}; if (!g.clear[today()]) { g.clear[today()] = now(); save(); } }
        card(); side();
      }

      function clear() {
        $('rvStage').innerHTML = `<section class="rv-clear" aria-label="Deck clear"><span class="lab">QUEST COMPLETE</span><h1>Deck clear</h1>
          <span>${total} card${total === 1 ? '' : 's'} reviewed. Next ones are due tomorrow.</span><a class="u-btn go" href="${href('/')}">Back to Learn</a>
          <span class="m-xp" aria-hidden="true">+${XP.deck} XP</span></section>`;
      }
      function empty() {
        $('rvStage').innerHTML = `<section class="rv-card rv-empty m-rise"><h1>${hadDue ? 'No cards due' : 'Nothing due right now'}</h1>
          <div class="rv-ans" style="border:0;padding:0">Finish lessons and solve problems; they come back here when it's time.</div></section>`;
      }

      // right rail: forecast (cards by rev.due), refreshers (rev.miss >= 2), clear-the-deck quest
      function side() {
        const A = all(), t = today(), D = [...Array(7)].map((_, j) => addDays(t, j)), cnt = D.map(() => 0);
        for (const st of Object.values(A)) for (const r of Object.values(st?.rev || {})) { const j = D.indexOf(r?.due); if (j > 0) cnt[j]++; }
        cnt[0] = total - i + probs.length;
        const mx = Math.max(1, ...cnt), names = D.map(d => new Date(d + 'T12:00:00').toLocaleDateString('en', {weekday: 'short'}));
        const bars = cnt.map((n, j) => { const h = Math.max(3, Math.round(n / mx * 70)); return `<rect x="${4 + j * 34}" y="${80 - h}" width="26" height="${h}" rx="3" fill="${j ? 'var(--accent-bar, #34507A)' : 'var(--accent)'}" style="animation-delay:${j ? 420 + j * 60 : 360}ms"/>`
          + `<text x="${17 + j * 34}" y="98" font-family="Geist Mono, monospace" font-size="10" fill="var(--muted)" text-anchor="middle">${names[j]}</text>`; }).join('');
        const refs = []; for (const [n, st] of Object.entries(A)) for (const [k, r] of Object.entries(st?.rev || {}))
          if ((r?.miss || 0) >= REFRESHER.misses) refs.push(n === 'practice' ? P[k]?.t : plain(Rv[n]?.[k]?.t || Rv[n]?.[k]?.q));
        const q = quests(A, events(A), t, total - i + probs.length).find(x => x.id === 'deck');
        $('rvSide').innerHTML = `
          <section class="u-card rv-fc m-slide" style="--i:4"><div class="hd"><b>Next 7 days</b><span class="mono">cards due</span></div>
            <svg width="100%" viewBox="0 0 240 110" role="img" aria-label="Cards due: ${cnt.map((n, j) => `${j ? names[j] : 'today'} ${n}`).join(', ')}">${bars}</svg></section>
          <section class="u-card rv-miss m-slide" style="--i:5"><b>Missed it twice?</b>
            <p>The card drops a ${REFRESHER.minutes}-minute refresher node onto your Learn path, just before the concept that needs it.</p>
            ${refs.filter(Boolean).length ? `<ul aria-label="Current refreshers">${refs.filter(Boolean).map(x => `<li>${esc(x)}</li>`).join('')}</ul>` : ''}</section>
          <section class="u-card rv-quest m-slide" style="--i:6"><div class="hd"><span>Clear the deck</span><span class="mono">${q.done ? 'done' : `+${XP.deck} XP · quest`}</span></div></section>`;
      }

      document.addEventListener('keydown', e => { if (e.code === 'Space' && !e.target.closest('a,button,input,textarea')) { e.preventDefault(); reveal(); } });
      card(); side();
    });
  </script>
</Unroll>
