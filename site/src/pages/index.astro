---
// Roadmap home: four layers, each with its courses and the study plans that practise them.
import Site from '../layouts/Site.astro';
import { getCollection } from 'astro:content';
import fs from 'node:fs';
import path from 'node:path';
const courses = await getCollection('courses');
const lessons = await getCollection('lessons');
const LAYERS = [
  {n: 1, name: 'Foundations', blurb: 'The maths and the tools everything else is written in.', plans: ['linear-algebra', 'probability-statistics', 'calculus', 'optimization', 'numpy', 'pandas', 'sql', 'pytorch', 'jax']},
  {n: 2, name: 'Core ML', blurb: 'Classical machine learning and deep learning, built from first principles.', plans: ['cracking-ml', 'cracking-dl', 'cracking-cv', 'cracking-nlp', 'cracking-rl', 'micrograd', 'diffusion', 'alphago']},
  {n: 3, name: 'LLMs & AI', blurb: 'How large language models are built, trained, adapted and put to work.', plans: ['llm-from-scratch']},
  {n: 4, name: 'Systems', blurb: 'Serving models fast and designing the systems around them.', plans: ['inference-engineering', 'cuda', 'triton']},
];
const PLANDIR = path.resolve(process.cwd(), '../practice/src/plans');
const plan = id => { try { const p = JSON.parse(fs.readFileSync(path.join(PLANDIR, id + '.json'), 'utf8')); return {id, title: p.title, problems: p.sections.flatMap(s => s.problems)}; } catch { return null; } };
const order = ['ml-maths-course', 'ml-toolkit', 'machine-learning', 'deep-learning', 'ai-research-track-web', 'ai-engineering-course', 'inference-eng-course', 'system-design-101', 'ml-system-design'];
const sorted = [...courses].sort((a, b) => order.indexOf(a.id) - order.indexOf(b.id));
const count = id => lessons.filter(l => l.data.course === id).length;
const total = lessons.length;
const practiceBase = import.meta.env.PUBLIC_PRACTICE_BASE ?? '/practice/index.html';
---
<Site title="Tracks">
  <section class="hero panel" style="min-height:0;padding:44px 44px 40px">
    <div class="lab">{sorted.length} courses · {total} lessons</div>
    <h1 style="margin:14px 0 10px">Everything you're learning, <span class="px">in one place.</span></h1>
    <p class="sub" style="font-size:17px;color:var(--muted);max-width:640px;margin:0">Machine learning, AI and the systems behind them, from the maths up. Each layer pairs its courses with study plans of hands-on problems.</p>
  </section>
  {LAYERS.map(L => { const cs = sorted.filter(c => c.data.layer === L.n), ps = L.plans.map(plan).filter(Boolean);
    return <section class="layer">
      <div class="ln"><span class="lab">Layer {L.n}</span><b>{L.name}</b><span>{L.blurb}</span></div>
      <div>
        <div class="mods">{cs.map(c => (
          <a class="card mcard course" href={`/courses/${c.id}/`} data-key={c.data.key} data-total={count(c.id)}>
            <div class="tp"><Fragment set:html={c.data.logo} /><span class="lab done-n">0/{count(c.id)}</span></div>
            <h4>{c.data.title}</h4>
            <p style="margin:0;color:var(--muted);font-size:14px;line-height:1.45;flex:1">{c.data.description}</p>
            <div class="bar"><i style="width:0%"></i></div>
            <div class="ft"><span>{c.data.modules.length} modules · {count(c.id)} lessons</span><span>Open →</span></div>
          </a>))}</div>
        {ps.length > 0 && <div class="plans"><span class="lab">Practice</span>{ps.map(p => <a class="plan" href={`${practiceBase}#plan-${p.id}`}>{p.title}<i>{p.problems.length}</i></a>)}</div>}
      </div>
    </section>; })}
  <script>
    // progress per course, from each course's saved data (same keys as before)
    document.querySelectorAll('.course[data-key]').forEach(a => {
      let done = {}; try { done = JSON.parse(localStorage.getItem(a.dataset.key) || '{}').done || {}; } catch {}
      const n = Object.values(done).filter(Boolean).length, t = +a.dataset.total;
      a.querySelector('.done-n').textContent = `${n}/${t}`; a.querySelector('.bar i').style.width = `${Math.min(100, 100 * n / t)}%`;
    });
  </script>
</Site>
<style>
  .layer{display:grid;grid-template-columns:150px minmax(0,1fr);gap:22px;padding:28px 0;border-top:1px solid var(--line)}
  .layer:first-of-type{border-top:0}
  .ln{display:flex;flex-direction:column;gap:6px}
  .ln b{font-size:24px;letter-spacing:-.03em;line-height:1.15}
  .ln span:last-child{color:var(--muted);font-size:13.5px;line-height:1.45}
  .mods .tp{display:flex;justify-content:space-between;align-items:center}
  .plans{display:flex;flex-wrap:wrap;gap:8px;margin-top:14px;align-items:center}
  .plan{display:inline-flex;gap:8px;align-items:center;padding:6px 12px;border-radius:999px;background:var(--card);border:1px solid var(--line);font-size:13.5px;text-decoration:none}
  .plan:hover{border-color:var(--accent)}
  .plan i{font:500 11px var(--mono);font-style:normal;color:var(--muted)}
  @media (max-width:820px){.layer{grid-template-columns:1fr;gap:12px}}
</style>
