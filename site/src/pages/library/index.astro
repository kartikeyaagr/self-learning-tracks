---
import { u } from '../../lib/url.mjs';
import Site from '../../layouts/Site.astro';
import { getCollection } from 'astro:content';
import { courseVar } from '../../lib/unroll.js';
const courses = await getCollection('courses');
const lessons = await getCollection('lessons');
---
<Site title="Library">
  <header class="pagehead"><div class="lab">Library · {courses.length} courses · {lessons.length} lessons</div><h1>Every course, whole</h1>
    <p>Routes borrow concepts from these courses. Open one to read it start to finish, module by module.</p></header>
  <div class="mods">{courses.sort((a, b) => a.data.layer - b.data.layer).map(c => (
    <a class="card mcard" href={u(`/library/${c.id}/`)} style={`--c:${courseVar(c.id)}`}><div class="tp"><span class="lab">Layer {c.data.layer}</span><span class="tag" aria-hidden="true"></span></div><h4>{c.data.title}</h4>
      <p style="margin:0;color:var(--muted);font-size:14px;flex:1">{c.data.description}</p>
      <div class="ft"><span>{c.data.modules.length} modules</span><span>{lessons.filter(l => l.data.course === c.id).length} lessons</span></div></a>))}</div>
</Site>
