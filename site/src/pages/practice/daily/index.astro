---
import Practice from '../../../layouts/Practice.astro';
---
<Practice title="Problem of the day" cur="daily"><p style="color:var(--muted)">Finding today's problem…</p>
  <script>
    import { today } from '../../../lib/progress.js';
    import { dailyIndex } from '../../../lib/game.js';
    fetch(`${window.__base}/practice/index.json`).then(r => r.json()).then(I => {
      const all = I.topics.flatMap(m => m.lessons);
      location.replace(`${window.__base}/arena/p/${all[dailyIndex(today(), all.length)].id}/`);
    });
  </script>
</Practice>
